{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/ui/*": [
        "./packages/ui/src/*"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "apps/*/server",
    "apps/*/shared",
    "apps/*/ui",
    "apps/mac/web"
  ]
}
