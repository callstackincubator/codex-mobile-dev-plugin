---
interface Props {
  src: string;
  poster: string;
  label: string;
  width?: number;
  height?: number;
}

const { src, poster, label, width = 1920, height = 1080 } = Astro.props;
---

<div class="feature-preview not-content">
  <video
    data-feature-preview
    src={src}
    poster={poster}
    aria-label={label}
    width={width}
    height={height}
    controls
    muted
    loop
    playsinline
    preload="none"
  ></video>
</div>

<script>
  import './feature-previews';
</script>

<style>
  .feature-preview {
    margin-top: 2rem;
    border: 1px solid var(--line-strong);
  }

  video {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
