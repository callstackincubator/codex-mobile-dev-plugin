---
// The close of a landing page: the accent CTA bar and the giant wordmark, as wide as the frame.
import { site } from '../../site/content';
import { giantSize } from './giant';
import InstallButton from './InstallButton.astro';
---

<section class="finale" aria-label="Install Mobile Dev">
  <InstallButton class="cta-bar" arrow />
  <p class="giant" aria-hidden="true" translate="no" style={`font-size: ${giantSize(site.wordmark)}`}>{site.wordmark}</p>
</section>
