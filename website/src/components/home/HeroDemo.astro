---
import FeaturePreview from '../site/FeaturePreview.astro';

const label = 'Point at an element in the running app, add a note, and send the selected element to the agent as context.';
---

<div class="hero-preview hero-preview--wide">
  <FeaturePreview
    src="/previews/annotation.mp4"
    poster="/previews/annotation.webp"
    label={label}
  />
</div>
<div class="hero-preview hero-preview--compact">
  <FeaturePreview
    src="/previews/annotation-compact.mp4"
    poster="/previews/annotation-compact.webp"
    label={label}
    width={716}
    height={1032}
  />
</div>

<style>
  .hero-preview :global(.feature-preview) {
    margin-top: 0;
    border: 0;
  }

  .hero-preview--compact {
    display: none;
  }

  @media (max-width: 600px) {
    .hero-preview--wide {
      display: none;
    }

    .hero-preview--compact {
      display: block;
    }
  }
</style>
