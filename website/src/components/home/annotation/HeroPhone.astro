---
import HeroIcon from './HeroIcon.astro';
---

<div class="hero-phone">
  <div class="phone-status"><span>17:44</span><span>▮▮▮ ▰</span></div>
  <div class="phone-island"></div>
  <div class="phone-logo">HorseTinder<HeroIcon name="heart" /></div>
  <div class="phone-profile" data-annotation-target="card">
    <div class="phone-photo"></div>
    <div class="phone-profile-info">
      <div class="phone-name">Monty, 9<HeroIcon name="check" /></div>
      <p>A curious friend for every trail</p>
      <div class="phone-tags"><span></span><span></span><span></span></div>
    </div>
  </div>
  <div class="phone-actions">
    <span class="phone-action"><HeroIcon name="close" /></span>
    <span class="phone-action phone-edit-action" data-annotation-target="action">
      <span class="phone-carrot-icon"><HeroIcon name="carrot" /></span>
      <span class="phone-apple-icon"><HeroIcon name="apple" /></span>
      <span class="hero-pin">1</span>
    </span>
    <span class="phone-action phone-like"><HeroIcon name="heart" /></span>
  </div>
  <div class="phone-home"></div>
</div>
