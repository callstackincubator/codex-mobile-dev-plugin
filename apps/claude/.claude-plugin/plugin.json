{
  "name": "mobile-dev",
  "displayName": "Mobile Dev",
  "description": "Stream iOS and Android devices into the chat while building, running, or debugging mobile apps. Read native and Metro logs, inspect and control apps, and record CPU, memory, and FPS. Apple Silicon development preview.",
  "author": {
    "name": "Callstack",
    "email": "hello@callstack.com"
  },
  "homepage": "https://github.com/callstackincubator/codex-mobile-dev-plugin",
  "repository": "https://github.com/callstackincubator/codex-mobile-dev-plugin",
  "license": "MIT",
  "keywords": [
    "ios",
    "android",
    "simulator",
    "emulator",
    "react-native",
    "expo",
    "logs",
    "performance"
  ],
  "icon": "./assets/icon.svg",
  "documentationUrl": "https://github.com/callstackincubator/codex-mobile-dev-plugin/tree/release/claude/plugins/mobile-dev#readme",
  "supportUrl": "https://github.com/callstackincubator/codex-mobile-dev-plugin/blob/main/SUPPORT.md",
  "privacyPolicyUrl": "https://github.com/callstackincubator/codex-mobile-dev-plugin/blob/main/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/callstackincubator/codex-mobile-dev-plugin/blob/main/TERMS.md",
  "mcpServers": {
    "mobile-dev": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch-node.sh",
        "${CLAUDE_PLUGIN_ROOT}/dist/server.mjs"
      ]
    }
  }
}
