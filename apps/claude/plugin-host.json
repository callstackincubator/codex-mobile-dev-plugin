{
  "label": "Claude",
  "manifest": ".claude-plugin",
  "root": "CLAUDE_PLUGIN_ROOT",
  "desktopBundle": "manifest.json",
  "config": {
    "file": "claude-desktop-config.json",
    "server": {},
    "target": "Claude Desktop Settings > Developer > Edit Config, then fully restart Claude"
  },
  "marketplace": {
    "name": "mobile-dev-local",
    "manifest": ".claude-plugin/marketplace.json"
  },
  "panels": false,
  "server": "tooling/build.mjs",
  "runtime": [
    "agent-device",
    "android-cpu",
    "android-fps",
    "app.html",
    "ios-fps",
    "ios-logs",
    "telemetry",
    "telemetry-environment.json",
    "third-party-licenses.txt"
  ],
  "skills": ["skills/mobile-dev"],
  "maxFileBytes": 5242880
}
