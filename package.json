{
  "name": "mobile-dev",
  "version": "0.1.168",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/ui",
    "packages/mcp-app",
    "packages/test-support",
    "apps/codex-plugin",
    "apps/claude",
    "apps/cursor",
    "apps/mac"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node tooling/build.mjs",
    "build:release": "node tooling/build.mjs --release",
    "build:mac": "node apps/mac/tooling/build.mjs",
    "public-release": "node tooling/public-release.mjs",
    "vendor:baguette": "node tooling/vendor-baguette.mjs",
    "vendor:agent-device": "npm ci --prefix packages/runtimes/agent-device --ignore-scripts --no-audit --no-fund",
    "rebuild:baguette": "node tooling/rebuild-baguette.mjs",
    "rebuild:ios-fps": "node tooling/build-fps.mjs ios",
    "rebuild:android-fps": "node tooling/build-fps.mjs android",
    "rebuild:android-cpu": "node tooling/build-android-cpu.mjs",
    "rebuild:ios-logs": "node tooling/build-ios-logs.mjs",
    "start": "/bin/sh apps/codex-plugin/scripts/launch-mcp.sh dist/server.mjs",
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\" \"tooling/test/*.test.ts\"",
    "build:hosts": "node tooling/hosts/build.mjs",
    "test:hosts": "playwright test -c tooling/hosts --grep-invert @visual",
    "test:visual": "playwright test -c tooling/hosts --grep @visual",
    "test:package": "node apps/codex-plugin/tooling/smoke-package.mjs",
    "test:mac": "node apps/mac/tooling/smoke.mjs",
    "test:discovery-diagnostics": "node tooling/smoke-discovery-diagnostics.mjs",
    "test:cpu-cache": "node tooling/smoke-cpu-cache.mjs",
    "test:agent-device": "node apps/codex-plugin/tooling/smoke-agent-device.mjs",
    "check:mcp-budget": "node apps/codex-plugin/tooling/mcp-tool-budget.mjs",
    "test:definition-diagnostics": "node tooling/smoke-definition-diagnostics.mjs",
    "test:reconnect": "node tooling/smoke-reconnect.mjs",
    "test:logs": "node tooling/smoke-logs.mjs",
    "test:ios-logs": "node tooling/smoke-logs.mjs --physical",
    "test:ios-cpu": "node tooling/smoke-ios-cpu.mjs",
    "package": "node apps/codex-plugin/tooling/package.mjs",
    "package:release": "node apps/codex-plugin/tooling/package.mjs --release",
    "claude:config": "node tooling/plugin-config.mjs claude",
    "package:claude": "node tooling/package-plugin.mjs claude",
    "test:claude": "node tooling/smoke-plugin.mjs claude",
    "cursor:config": "node tooling/plugin-config.mjs cursor",
    "package:cursor": "node tooling/package-plugin.mjs cursor",
    "test:cursor": "node tooling/smoke-plugin.mjs cursor",
    "vendor:serve-emu": "node tooling/vendor-serve-emu.mjs",
    "dev": "node apps/codex-plugin/tooling/dev-ui.mjs",
    "dev:off": "node apps/codex-plugin/tooling/dev-ui.mjs --off",
    "test:stream": "node tooling/smoke-stream.mjs",
    "rebuild:ios-mirror": "node tooling/build-ios-mirror.mjs",
    "test:ios-mirror": "node tooling/smoke-ios-mirror.mjs",
    "test:ios-mirror-sharing": "node tooling/smoke-ios-mirror-sharing.mjs",
    "test:native-telemetry": "node tooling/smoke-native-telemetry.mjs",
    "sentry:upload": "node tooling/upload-sourcemaps.mjs",
    "typecheck:telemetry": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --allowImportingTsExtensions packages/shared/src/telemetry.ts packages/core/src/instrument.ts packages/core/src/telemetry.ts packages/core/src/storage-metrics.ts packages/ui/src/telemetry.ts",
    "test:codex-plugin": "node apps/codex-plugin/tooling/smoke-codex-plugin.mjs",
    "test:updates": "node apps/codex-plugin/tooling/smoke-plugin-updates.mjs",
    "prepare": "husky",
    "lint:commits": "commitlint",
    "check:marketplace-review": "node apps/codex-plugin/tooling/check-marketplace-review.mjs",
    "test:visual:docker": "node tooling/hosts/docker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@callstack/tracesift-explore": "^0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@legendapp/list": "^3.6.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/mcp-extensions": "0.1.0",
    "@rozenite/ui": "2.4.0",
    "@sentry/node": "11.2.0",
    "@sentry/react": "11.2.0",
    "ajv": "8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "undici": "8.12.1",
    "ws": "8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.1",
    "@sentry/cli": "2.58.6",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  }
}
