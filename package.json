{
  "name": "codex-mobile-dev-plugin",
  "version": "0.1.181",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "public-release": "node scripts/public-release.mjs",
    "vendor:baguette": "node scripts/vendor-baguette.mjs",
    "vendor:agent-device": "npm ci --prefix runtimes/agent-device --ignore-scripts --no-audit --no-fund",
    "rebuild:baguette": "node scripts/rebuild-baguette.mjs",
    "rebuild:ios-fps": "node scripts/build-fps.mjs ios",
    "rebuild:android-fps": "node scripts/build-fps.mjs android",
    "rebuild:android-cpu": "node scripts/build-android-cpu.mjs",
    "rebuild:ios-logs": "node scripts/build-ios-logs.mjs",
    "start": "node dist/server.mjs",
    "test": "node --test tests/*.test.ts",
    "test:package": "node scripts/smoke-package.mjs",
    "test:installed": "node scripts/smoke-installed-plugin.mjs",
    "test:cpu-cache": "node scripts/smoke-cpu-cache.mjs",
    "test:agent-device": "node scripts/smoke-agent-device.mjs",
    "check:mcp-budget": "node scripts/mcp-tool-budget.mjs",
    "test:reconnect": "node scripts/smoke-reconnect.mjs",
    "test:logs": "node scripts/smoke-logs.mjs",
    "test:ios-logs": "node scripts/smoke-logs.mjs --physical",
    "test:ios-cpu": "node scripts/smoke-ios-cpu.mjs",
    "package": "node scripts/package.mjs",
    "package:release": "node scripts/package.mjs --release",
    "vendor:serve-emu": "node scripts/vendor-serve-emu.mjs",
    "dev": "node scripts/dev-ui.mjs",
    "dev:off": "node scripts/dev-ui.mjs --off",
    "test:stream": "node scripts/smoke-stream.mjs",
    "rebuild:ios-mirror": "node scripts/build-ios-mirror.mjs",
    "test:ios-mirror": "node scripts/smoke-ios-mirror.mjs",
    "test:native-telemetry": "node scripts/smoke-native-telemetry.mjs",
    "sentry:upload": "node scripts/upload-sourcemaps.mjs",
    "typecheck:telemetry": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --allowImportingTsExtensions src/shared/telemetry.ts src/server/instrument.ts src/server/telemetry.ts src/server/storage-metrics.ts src/ui/telemetry.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@legendapp/list": "^3.6.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/mcp-extensions": "0.1.0",
    "@sentry/node": "11.2.0",
    "@sentry/react": "11.2.0",
    "ajv": "8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "ws": "8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.6",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "@babel/core": "7.29.7"
  }
}
