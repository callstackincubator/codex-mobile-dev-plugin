{
  "name": "a11y",
  "version": "1.2.0",
  "apiVersion": 1,
  "description": "Accessibility audit for the current screen, and the display settings to run it under",
  "icon": "accessibility",
  "capabilities": ["describe-ui", "interface"],
  "contributes": {
    "commands": [
      { "id": "audit", "title": "Run accessibility audit", "run": ["/usr/bin/python3", "bin/audit.py"] },
      { "id": "display", "title": "Display & text size", "run": ["/usr/bin/python3", "bin/display.py"] }
    ],
    "panels": [
      {
        "id": "audit",
        "title": "Accessibility",
        "icon": "accessibility",
        "when": "simulator.booted",
        "body": { "kind": "list", "source": "audit", "rowAction": "highlight" }
      },
      {
        "id": "display",
        "title": "Display & Text Size",
        "icon": "wrench",
        "when": "simulator.booted",
        "body": {
          "kind": "list",
          "source": "display",
          "rowAction": "run",
          "control": { "kind": "radio", "arg": "settings", "submit": "Apply" }
        }
      }
    ]
  }
}
