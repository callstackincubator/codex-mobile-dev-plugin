{
  "name": "@limrun/api",
  "version": "0.24.5",
  "description": "The official TypeScript library for the Limrun API",
  "author": "Limrun <contact@limrun.com>",
  "types": "./index.d.ts",
  "main": "./index.js",
  "type": "commonjs",
  "repository": "github:limrun-inc/typescript-sdk",
  "license": "Apache-2.0",
  "packageManager": "yarn@1.22.22",
  "files": [
    "**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "./scripts/test",
    "build": "./scripts/build",
    "format": "./scripts/format",
    "tsn": "ts-node -r tsconfig-paths/register",
    "lint": "./scripts/lint",
    "fix": "./scripts/format"
  },
  "dependencies": {
    "eventsource-client": "^1.2.0",
    "https-proxy-agent": "7.0.6",
    "ignore": "^7.0.5",
    "proxy-from-env": "^2.1.0",
    "undici": "7.24.7",
    "ws": "^8.18.3"
  },
  "overrides": {
    "minimatch": "^9.0.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^9.0.5"
    }
  },
  "resolutions": {
    "minimatch": "^9.0.5"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./api-promise": {
      "import": "./api-promise.mjs",
      "require": "./api-promise.js"
    },
    "./api-promise.js": {
      "default": "./api-promise.js"
    },
    "./api-promise.mjs": {
      "default": "./api-promise.mjs"
    },
    "./client": {
      "import": "./client.mjs",
      "require": "./client.js"
    },
    "./client.js": {
      "default": "./client.js"
    },
    "./client.mjs": {
      "default": "./client.mjs"
    },
    "./core/*.mjs": {
      "default": "./core/*.mjs"
    },
    "./core/*.js": {
      "default": "./core/*.js"
    },
    "./core/*": {
      "import": "./core/*.mjs",
      "require": "./core/*.js"
    },
    "./error": {
      "import": "./error.mjs",
      "require": "./error.js"
    },
    "./error.js": {
      "default": "./error.js"
    },
    "./error.mjs": {
      "default": "./error.mjs"
    },
    "./exec-client": {
      "import": "./exec-client.mjs",
      "require": "./exec-client.js"
    },
    "./exec-client.js": {
      "default": "./exec-client.js"
    },
    "./exec-client.mjs": {
      "default": "./exec-client.mjs"
    },
    "./folder-sync-ignore": {
      "import": "./folder-sync-ignore.mjs",
      "require": "./folder-sync-ignore.js"
    },
    "./folder-sync-ignore.js": {
      "default": "./folder-sync-ignore.js"
    },
    "./folder-sync-ignore.mjs": {
      "default": "./folder-sync-ignore.mjs"
    },
    "./folder-sync-watcher": {
      "import": "./folder-sync-watcher.mjs",
      "require": "./folder-sync-watcher.js"
    },
    "./folder-sync-watcher.js": {
      "default": "./folder-sync-watcher.js"
    },
    "./folder-sync-watcher.mjs": {
      "default": "./folder-sync-watcher.mjs"
    },
    "./folder-sync": {
      "import": "./folder-sync.mjs",
      "require": "./folder-sync.js"
    },
    "./folder-sync.js": {
      "default": "./folder-sync.js"
    },
    "./folder-sync.mjs": {
      "default": "./folder-sync.mjs"
    },
    "./index": {
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./index.js": {
      "default": "./index.js"
    },
    "./index.mjs": {
      "default": "./index.mjs"
    },
    "./instance-client": {
      "import": "./instance-client.mjs",
      "require": "./instance-client.js"
    },
    "./instance-client.js": {
      "default": "./instance-client.js"
    },
    "./instance-client.mjs": {
      "default": "./instance-client.mjs"
    },
    "./ios-client": {
      "import": "./ios-client.mjs",
      "require": "./ios-client.js"
    },
    "./ios-client.js": {
      "default": "./ios-client.js"
    },
    "./ios-client.mjs": {
      "default": "./ios-client.mjs"
    },
    "./pagination": {
      "import": "./pagination.mjs",
      "require": "./pagination.js"
    },
    "./pagination.js": {
      "default": "./pagination.js"
    },
    "./pagination.mjs": {
      "default": "./pagination.mjs"
    },
    "./resource": {
      "import": "./resource.mjs",
      "require": "./resource.js"
    },
    "./resource.js": {
      "default": "./resource.js"
    },
    "./resource.mjs": {
      "default": "./resource.mjs"
    },
    "./resources/*.mjs": {
      "default": "./resources/*.mjs"
    },
    "./resources/*.js": {
      "default": "./resources/*.js"
    },
    "./resources/*": {
      "import": "./resources/*.mjs",
      "require": "./resources/*.js"
    },
    "./resources": {
      "import": "./resources.mjs",
      "require": "./resources.js"
    },
    "./resources.js": {
      "default": "./resources.js"
    },
    "./resources.mjs": {
      "default": "./resources.mjs"
    },
    "./tunnel": {
      "import": "./tunnel.mjs",
      "require": "./tunnel.js"
    },
    "./tunnel.js": {
      "default": "./tunnel.js"
    },
    "./tunnel.mjs": {
      "default": "./tunnel.mjs"
    },
    "./uploads": {
      "import": "./uploads.mjs",
      "require": "./uploads.js"
    },
    "./uploads.js": {
      "default": "./uploads.js"
    },
    "./uploads.mjs": {
      "default": "./uploads.mjs"
    },
    "./version": {
      "import": "./version.mjs",
      "require": "./version.js"
    },
    "./version.js": {
      "default": "./version.js"
    },
    "./version.mjs": {
      "default": "./version.mjs"
    }
  }
}