{
  "mcpServers": {
    "mobile-dev": {
      "command": "./scripts/launch-mcp",
      "args": [
        "./dist/server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "ANDROID_AVD_HOME",
        "ANDROID_USER_HOME",
        "CODEX_HOME",
        "DEVELOPER_DIR",
        "TRACE_SIFT_HOME",
        "TRACE_SIFT_COMMAND",
        "MOBILE_DEV_TELEMETRY",
        "MOBILE_DEV_ENVIRONMENT",
        "MOBILE_DEV_PANEL"
      ]
    }
  }
}
